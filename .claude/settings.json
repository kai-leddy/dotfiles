{
  "permissions": {
    "allow": [
      "Bash(cat)",
      "Bash(pbcopy)",
      "Bash(pbpaste)",
      "WebFetch(domain:as.atlassian.com)"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "network": {
      "allowMachLookup": [
        "com.apple.pasteboard.*"
      ]
    },
    "filesystem": {
      "allowWrite": [],
      "allowRead": [
        "~/.config/gh"
      ]
    },
    "excludedCommands": [
      "pnpm run *"
    ]
  },
  "effortLevel": "high",
  "theme": "auto"
}
