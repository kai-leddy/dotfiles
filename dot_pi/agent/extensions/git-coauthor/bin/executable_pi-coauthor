#!/usr/bin/env bash
# Print the "Co-authored-by:" trailer for the model running this Pi session, from PI_PROVIDER and PI_MODEL.
# Used by the commit-msg hook in ../hooks, and by hand (Pi puts this directory on PATH):  git commit --trailer "$(pi-coauthor)" ...
# Exits 1 (and says why on stderr) when it cannot name the model or does not know the vendor's address.
set -euo pipefail

provider=${PI_PROVIDER:-}
model=${PI_MODEL:-}
if [ -z "$model" ]; then echo "pi-coauthor: PI_MODEL is not set" >&2; exit 1; fi

# "openai/gpt-6-luna" (OpenRouter) -> vendor openai, id gpt-6-luna
vendor=""
id=$model
case $model in */*) vendor=${model%%/*}; id=${model##*/} ;; esac

# Display name: claude-sonnet-5-5 -> "Claude Sonnet 5.5", gpt-6-luna -> "GPT-6 Luna", gemini-3.8-flash -> "Gemini 3.8 Flash"
name=$(awk -v m="$id" 'BEGIN {
  n = split(m, p, "-"); out = ""; prev_gpt = 0
  for (i = 1; i <= n; i++) {
    w = p[i]
    if (w ~ /^[0-9.]+$/) {
      while (i < n && w ~ /^[0-9]+$/ && p[i + 1] ~ /^[0-9]+$/) { w = w "." p[i + 1]; i++ }
      sep = prev_gpt ? "-" : " "
      prev_gpt = 0
    } else {
      if (w == "gpt") w = "GPT"; else if (w ~ /^[a-z]/) w = toupper(substr(w, 1, 1)) substr(w, 2)
      prev_gpt = (w == "GPT"); sep = " "
    }
    out = (out == "" ? w : out sep w)
  }
  print out
}')

# Provider decides the address. GitHub links the numeric one to the Copilot account.
email=""
case $provider in
  anthropic) email="noreply@anthropic.com" ;;
  openai|openai-codex) email="noreply@openai.com" ;;
  google|google-vertex|google-gemini-cli) email="noreply@google.com" ;;
  github-copilot) email="223556219+Copilot@users.noreply.github.com"; name="$name (via Copilot)" ;;
  *)
    case $vendor in
      anthropic) email="noreply@anthropic.com" ;;
      openai) email="noreply@openai.com" ;;
      google) email="noreply@google.com" ;;
    esac ;;
esac

if [ -z "$email" ]; then
  echo "pi-coauthor: no known address for provider '$provider' (model '$model'); add the trailer by hand" >&2
  exit 1
fi

printf 'Co-authored-by: %s <%s>\n' "$name" "$email"
