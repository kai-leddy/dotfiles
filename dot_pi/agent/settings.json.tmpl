{{- /*
  This file is host-specific. It used to be yadm's `##default` /
  `##hostname.<name>` alt-file mechanism; now it templates just the
  differences between the work-laptop config and the
  main-pc config, which is the default/base.
*/ -}}
{{- $isWorkLaptop := eq .machine "work-laptop" -}}
{
  "lastChangelogVersion": "1.5.0",
  "theme": "catppuccin-mocha",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "only"
  },
  "defaultProvider": {{ ternary "\"anthropic\"" "\"github-copilot\"" $isWorkLaptop }},
  "defaultModel": {{ ternary "\"claude-sonnet-5-5\"" "\"gpt-6-luna\"" $isWorkLaptop }},
  "enabledModels": [{{ if $isWorkLaptop }}
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",{{ end }}
    "github-copilot/gemini-3.8-flash",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/gpt-6.1-terra",
    "github-copilot/gpt-6-luna",
    "deepinfra/zai-org/GLM-5.3-Flash",
    "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash",
    "deepinfra/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B",
    "deepinfra/google/gemma-4-31B-it",
    "deepinfra/Qwen/Qwen3-235B-A22B-Instruct-2507",
    "deepinfra/XiaomiMiMo/MiMo-V2.6-Flash"
  ],
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "none",
  "packages": [
    "npm:@watercol/pi-lens-simple",
    "npm:@gotgenes/pi-subagents",
    "npm:@99percentpeople/pi-todo",
    "npm:pi-skill-acli",
    "npm:pi-blackhole",
    "npm:@mnemosyne-oss/pi-mnemosyne",
    "npm:@codexstar/pi-listen"
  ],
  "shadedCodeBlocks": true,
  "hideThinkingBlock": true{{ if $isWorkLaptop }},
  "warnings": {
    "anthropicExtraUsage": false
  }{{ end }},
  "terminal": {
    "imageWidthCells": 120
  },
  "shellPath": "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/bash{{ else }}/usr/bin/bash{{ end }}",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@watercol/pi-lens-simple\",\"scope\":\"user\"}": "1.0.0",
    "{\"source\":\"npm:@gotgenes/pi-subagents\",\"scope\":\"user\"}": "25.0.5",
    "{\"source\":\"npm:pi-blackhole\",\"scope\":\"user\"}": "0.5.17"
  },
  "voice": {
    "version": 2,
    "enabled": true,
    "language": "en",
    "scope": "global",
    "backend": "local",
    "localModel": "parakeet-v2",
    "toggleShortcut": "ctrl+shift+v",
    "ttsEnabled": false,
    "ttsBackend": "local",
    "ttsLocalModel": "piper-en_US-lessac-medium-int8",
    "ttsLocalVoiceId": 0,
    "ttsDeepgramVoiceId": "aura-asteria-en",
    "ttsSpeed": 1,
    "ttsAutoSpeak": true,
    "autoSubmitOnSpeak": true,
    "holdThresholdMs": 700,
    "ttsDeepgramStreaming": false,
    "ttsOnboardingShown": false,
    "onboarding": {
      "completed": true,
      "schemaVersion": 2,
      "completedAt": "2026-11-06T10:50:06.568Z",
      "source": "migration"
    }
  }
}
{{- "" }}