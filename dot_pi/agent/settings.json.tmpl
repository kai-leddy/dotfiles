{{- /*
  This file is host-specific. It used to be yadm's `##default` /
  `##hostname.<name>` alt-file mechanism; now it templates just the
  differences between the camjamfmac021 (work laptop) config and the
  main-pc config, which is the default/base.
*/ -}}
{{- $isCamjam := eq .chezmoi.hostname "camjamfmac021" -}}
{
  "lastChangelogVersion": "0.86.1",
  "theme": "catppuccin-mocha",
  "defaultProvider": {{ ternary "\"anthropic\"" "\"github-copilot\"" $isCamjam }},
  "defaultModel": {{ ternary "\"claude-sonnet-5\"" "\"gpt-6-luna\"" $isCamjam }},
  "enabledModels": [{{ if $isCamjam }}
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5-5",{{ end }}
    "github-copilot/gemini-3.8-flash",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-6-luna",
    "deepinfra/zai-org/GLM-5.3-Flash",
    "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash",
    "deepinfra/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B",
    "deepinfra/google/gemma-4-31B-it",
    "deepinfra/Qwen/Qwen3-235B-A22B-Instruct-2507",
    "deepinfra/XiaomiMiMo/MiMo-V2.6-Flash"
  ],
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "packages": [
    "npm:pi-open-tui",
    "npm:@watercol/pi-lens-simple",
    "npm:@gotgenes/pi-subagents",
    "npm:@99percentpeople/pi-todo",
    "npm:pi-skill-acli",
    "npm:pi-blackhole",
    "npm:@heyhuynhgiabuu/pi-pretty",
    "npm:@mnemosyne-oss/pi-mnemosyne"
  ],
  "hideThinkingBlock": false{{ if $isCamjam }},
  "warnings": {
    "anthropicExtraUsage": false
  }{{ end }}
}
